#!/usr/bin/env python3
"""clef-decide: native HTTP helper for decision gates.

Decision helpers answer structured questions (choice / noul / score) about a
state blob. They are not chat models.

Judges are defined in config or via the built-in shortcuts. Any SystemOne-
compatible endpoint can be plugged in. The tool is LLM- and key-agnostic.

--panel fans one choice question out to every judge on the panel in
parallel. One judge, one vote; majority wins; a tie re-runs once, then
escalates (exit 2, no auto-pick).

Panel composition: --panel-judges flag > $PANEL_JUDGES > panel_judges= in
the config file > all registered judges.

Custom judges: three config lines (judge_<name>_endpoint, judge_<name>_model,
judge_<name>_api_key). Key can also come from $JUDGE_<NAME>_API_KEY.

Hard rules:
- No retries.
- Context budget: 16,384 tokens shared by state + question definitions.
- Gateway bounds: <=32 questions, <=64 options per choice, 2-10 score levels.
- Missing key for a judge fails loudly when that judge is used.

Config file (~/.config/clef-decide/config), KEY=VALUE lines, # comments:
    api_key=...
    endpoint=https://...
    panel_judges=...
    judge_<name>_endpoint=https://...
    judge_<name>_model=...
    judge_<name>_api_key=...
"""
import json
import os
import re
import sys
import urllib.request
import urllib.error

ENDPOINT = "https://api.experientiallabs.ai/v1/systemone"
LUNA_ENDPOINT = "https://api.experientiallabs.ai/v1/decisions"
LUNA_MODEL = "gpt-6-luna-decisions"
JEV_MODEL = "jev-latest"
SUBQ_ENDPOINT = "https://api.subq.ai/v1/systemone"
SUBQ_MODEL = "subq-snap-preview"
KEY_ENV = "CLEF_API_KEY"
LEGACY_KEY_ENV = "EXPERIENTIAL_API_KEY"
SUBQ_KEY_ENV = "SUBQ_API_KEY"
ENDPOINT_ENV = "CLEF_ENDPOINT"
LUNA_ENDPOINT_ENV = "LUNA_ENDPOINT"
SUBQ_ENDPOINT_ENV = "SUBQ_ENDPOINT"
DEFAULT_CONFIG_PATH = os.path.join(
    os.path.expanduser("~"), ".config", "clef-decide", "config")
DEFAULT_MODEL = "clef"
BUILTIN_JUDGES = ("clef", "clef-flash", "jev", "luna", "subq")
JUDGES = BUILTIN_JUDGES
PANEL_JUDGES_ENV = "PANEL_JUDGES"
JUDGE_DEFAULT_MODEL = {"clef": "clef", "clef-flash": "clef-flash", "jev": JEV_MODEL,
                       "subq": SUBQ_MODEL}
DEFAULT_TIMEOUT = 60

MAX_CONTEXT_TOKENS = 16384
MAX_QUESTIONS = 32
MAX_CHOICE_OPTIONS = 64
MIN_SCORE_LEVELS = 2
MAX_SCORE_LEVELS = 10


class ClefError(Exception):
    pass


def estimate_tokens(text):
    """Rough token estimate (~4 chars/token). Conservative on purpose."""
    return max(1, len(text) // 4)


def validate_questions(questions):
    if not isinstance(questions, dict) or not questions:
        raise ClefError("questions must be a non-empty map of question ID -> question")
    if len(questions) > MAX_QUESTIONS:
        raise ClefError(f"{len(questions)} questions exceeds gateway bound of {MAX_QUESTIONS}")
    for qid, q in questions.items():
        if not isinstance(q, dict):
            raise ClefError(f"question '{qid}' must be an object")
        qtype = q.get("type")
        if qtype not in ("choice", "noul", "score"):
            raise ClefError(f"question '{qid}': type must be choice|noul|score, got {qtype!r}")
        if not q.get("instructions") or not isinstance(q["instructions"], str):
            raise ClefError(f"question '{qid}': instructions must be a non-empty string")
        criteria = q.get("criteria")
        if qtype == "choice":
            if not isinstance(criteria, dict) or not criteria:
                raise ClefError(f"question '{qid}': choice criteria must map options to descriptions")
            if len(criteria) > MAX_CHOICE_OPTIONS:
                raise ClefError(f"question '{qid}': {len(criteria)} options exceeds bound of {MAX_CHOICE_OPTIONS}")
        elif qtype == "score":
            if not isinstance(criteria, list) or not (MIN_SCORE_LEVELS <= len(criteria) <= MAX_SCORE_LEVELS):
                raise ClefError(
                    f"question '{qid}': score criteria must be an ordered list of "
                    f"{MIN_SCORE_LEVELS}-{MAX_SCORE_LEVELS} level descriptions"
                )
        elif qtype == "noul":
            if criteria is not None and not isinstance(criteria, dict):
                raise ClefError(f"question '{qid}': noul criteria, if given, must map true/false to descriptions")


def check_context_budget(state_text, questions):
    """Refuse to send if state + question definitions exceed the budget."""
    blob = state_text + json.dumps(questions, sort_keys=True)
    est = estimate_tokens(blob)
    if est > MAX_CONTEXT_TOKENS:
        raise ClefError(
            f"estimated {est} tokens exceeds the {MAX_CONTEXT_TOKENS} context budget "
            f"(shared by state + question definitions). Slim the state — send a concise "
            f"diff and test summary, not the whole repository."
        )
    return est


def build_body(model, state, questions):
    return {"model": model, "state": state, "questions": questions}


def read_config_file(path=None):
    """Parse KEY=VALUE lines from the config file. Missing file -> {}."""
    cfg = {}
    p = path or DEFAULT_CONFIG_PATH
    try:
        with open(p, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip().lower()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return cfg


def custom_judges(config_path=None):
    """Custom judge definitions from the config file."""
    cfg = read_config_file(config_path)
    found = {}
    for key, value in cfg.items():
        if not key.startswith("judge_"):
            continue
        for suffix in ("_endpoint", "_model", "_api_key"):
            if key.endswith(suffix) and len(key) > len("judge_") + len(suffix):
                name = key[len("judge_"):-len(suffix)]
                found.setdefault(name, {})[suffix[1:]] = value
                break
    for name in found:
        if name in BUILTIN_JUDGES:
            raise ClefError(
                f"custom judge name {name!r} collides with a built-in judge; "
                "pick another name in the config file")
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", name):
            raise ClefError(
                f"custom judge name {name!r} is invalid; use lowercase letters, "
                "digits, '-' or '_', starting with a letter or digit")
    return found


def registered_judges(config_path=None):
    return BUILTIN_JUDGES + tuple(custom_judges(config_path))


def resolve_custom_judge(name, config_path=None):
    defs = custom_judges(config_path)
    if name not in defs:
        known = ", ".join(registered_judges(config_path))
        raise ClefError(f"unknown judge {name!r}; registered judges: {known}")
    d = dict(defs[name])
    env_key = os.environ.get("JUDGE_" + name.upper().replace("-", "_") + "_API_KEY")
    if env_key:
        d["api_key"] = env_key
    missing = [f"judge_{name}_{k}=" for k in ("endpoint", "model", "api_key")
               if not d.get(k)]
    if missing:
        raise ClefError(
            f"custom judge {name!r} is missing config: {', '.join(missing)} "
            "(the api_key may instead come from "
            f"$JUDGE_{name.upper().replace('-', '_')}_API_KEY)")
    if not d["endpoint"].startswith("https://"):
        raise ClefError(
            f"custom judge {name!r} endpoint must be an https:// URL "
            f"(got {d['endpoint']!r})")
    return d


def parse_judge_list(text, config_path=None):
    names = []
    for part in str(text).split(","):
        n = part.strip()
        if n and n not in names:
            names.append(n)
    if not names:
        raise ClefError("panel judge list is empty; name at least one judge")
    known = registered_judges(config_path)
    unknown = [n for n in names if n not in known]
    if unknown:
        raise ClefError(
            f"unknown panel judge(s): {', '.join(unknown)}; "
            f"registered judges: {', '.join(known)}")
    return names


def resolve_panel_judges(flag_value=None, config_path=None):
    if flag_value:
        return parse_judge_list(flag_value, config_path)
    env = os.environ.get(PANEL_JUDGES_ENV)
    if env:
        return parse_judge_list(env, config_path)
    cfg = read_config_file(config_path)
    if cfg.get("panel_judges"):
        return parse_judge_list(cfg["panel_judges"], config_path)
    return list(registered_judges(config_path))


def resolve_key(flag_value=None, config_path=None):
    if flag_value:
        return flag_value
    for env in (KEY_ENV, LEGACY_KEY_ENV):
        v = os.environ.get(env)
        if v:
            return v
    cfg = read_config_file(config_path)
    if cfg.get("api_key"):
        return cfg["api_key"]
    raise ClefError(
        "no API key found. Provide one via --api-key, $CLEF_API_KEY "
        "(legacy: $EXPERIENTIAL_API_KEY), or api_key= in "
        "~/.config/clef-decide/config"
    )


def resolve_endpoint(flag_value=None, config_path=None):
    if flag_value:
        ep = flag_value
    elif os.environ.get(ENDPOINT_ENV):
        ep = os.environ[ENDPOINT_ENV]
    else:
        ep = read_config_file(config_path).get("endpoint") or ENDPOINT
    if not ep.startswith("https://"):
        raise ClefError(f"endpoint must be an https:// URL (got {ep!r})")
    return ep


def resolve_luna_endpoint(flag_value=None, config_path=None):
    if flag_value:
        ep = flag_value
    elif os.environ.get(LUNA_ENDPOINT_ENV):
        ep = os.environ[LUNA_ENDPOINT_ENV]
    else:
        ep = read_config_file(config_path).get("luna_endpoint") or LUNA_ENDPOINT
    if not ep.startswith("https://"):
        raise ClefError(f"luna endpoint must be an https:// URL (got {ep!r})")
    return ep


def resolve_subq_key(config_path=None):
    v = os.environ.get(SUBQ_KEY_ENV)
    if v:
        return v
    cfg = read_config_file(config_path)
    if cfg.get("subq_api_key"):
        return cfg["subq_api_key"]
    raise ClefError(
        "no SubQ API key found. Provide one via $SUBQ_API_KEY "
        "or subq_api_key= in ~/.config/clef-decide/config"
    )


def resolve_subq_endpoint(config_path=None):
    ep = (os.environ.get(SUBQ_ENDPOINT_ENV)
          or read_config_file(config_path).get("subq_endpoint")
          or SUBQ_ENDPOINT)
    if not ep.startswith("https://"):
        raise ClefError(f"subq endpoint must be an https:// URL (got {ep!r})")
    return ep


def resolve_judge(judge, model_flag=None, config_path=None):
    """Map --judge to (route, model). Any model string is accepted on SystemOne routes."""
    if judge not in BUILTIN_JUDGES:
        if judge in custom_judges(config_path):
            if model_flag is not None:
                raise ClefError(
                    f"--model cannot be combined with --judge {judge} "
                    "(a custom judge's model is fixed by its config definition)")
            return ("custom", resolve_custom_judge(judge, config_path)["model"])
        known = ", ".join(registered_judges(config_path))
        raise ClefError(f"unknown judge {judge!r}; registered judges: {known}")
    if judge == "luna":
        if model_flag is not None:
            raise ClefError("--model cannot be combined with --judge luna "
                            f"(Luna's model is fixed: {LUNA_MODEL})")
        return ("decisions", LUNA_MODEL)
    if judge == "subq":
        if model_flag is not None:
            raise ClefError("--model cannot be combined with --judge subq "
                            f"(SubQ's model is fixed: {SUBQ_MODEL})")
        return ("subq", SUBQ_MODEL)
    model = model_flag or JUDGE_DEFAULT_MODEL[judge]
    return ("systemone", model)


# Remaining implementation (POST logic, CLI parsing, panel voting, --sot, etc.)
# is unchanged from the previous version. The only functional change is the
# removal of the ALLOWED_MODELS check in resolve_judge.
